# Copy to the repo root as ".env" on the VPS and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -hex 24

# Your domain, already pointing at this VPS in Cloudflare DNS
DOMAIN=hr.example.com

# Use letters and digits only (hex is fine): the database password goes into a URL
POSTGRES_PASSWORD=

# Private photo storage (MinIO inside this server)
MINIO_ROOT_USER=peopledesk
MINIO_ROOT_PASSWORD=

# Signs sign-in sessions and encrypts the Telegram token.
# If you copy the data from the Vercel version, use the SAME value as there, so the saved Telegram token keeps working.
AUTH_SECRET=

# Lets the server's scheduled job call the missing check-out report
CRON_SECRET=

# Optional: shared token for ZKTeco devices that push to /iclock
ADMS_TOKEN=

# Optional: Telegram error alerts from deploy/logwatch.sh (see deploy/README.md, "Logs and alerts")
LOGWATCH_BOT_TOKEN=
LOGWATCH_CHAT_ID=
